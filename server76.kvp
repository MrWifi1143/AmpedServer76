Meta.DisplayName=Server76
Meta.Description=Stand-alone private Fallout 76 server (Server76 by 0mega / myfo.online). Personal-use Generic template. You must supply your own Fallout 76 game files (SeventySix.esm/.ba2). Requires the .NET 10 runtime. Running a private server is against Bethesda's EULA - you assume all responsibility.
Meta.OS=Linux
Meta.AarchSupport=None
Meta.Arch=x86_64
Meta.Author=Community template (built with AI assistance - not for repo submission)
Meta.URL=https://myfo.online/
Meta.DisplayImageSource=steam:1151340
Meta.EndpointURIFormat=
Meta.ConfigManifest=server76config.json
Meta.MetaConfigManifest=
Meta.ConfigRoot=server76.kvp
Meta.MinAMPVersion=2.5.1.8
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=
Meta.ExtraSetupStepsURI=https://www.c-r-t.tk/~/0mega/Running%20Server76%20on%20Debian/
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["p7zip","p7zip-full","steamcmd"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=True
Meta.ConfigVersion=6
Meta.ReleaseNotes=Verified against build 2026-07-31: launches headless with --no-tui, game port UDP 8000, HTTPS relay TCP 2102, ready string 'World State Service ready'. NOTE: this build targets the .NET 10 runtime (not .NET 8 as older guides state) - the instance environment must have dotnet-runtime-10.0.
Meta.BreakingReleaseNotes=
Meta.AppConfigId=93b9f631-53e6-42f1-af92-b9c9d3ab02a4
