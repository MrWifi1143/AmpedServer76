Meta.DisplayName=Server76
Meta.Description=Stand-alone private Fallout 76 server (Server76 by 0mega / myfo.online). Personal-use Generic template, battle-tested. You must supply your own Fallout 76 game files (SeventySix.esm, NW.esm, SeventySix - Localization.ba2, Terrain/Appalachia.btd). Requires the .NET 10 runtime on the host. Running a private server is against Bethesda's EULA - you assume all responsibility.
Meta.OS=Linux
Meta.AarchSupport=None
Meta.Arch=x86_64
Meta.Author=Community template (built with AI assistance - not for CubeCoders repo submission)
Meta.URL=https://myfo.online/
Meta.DisplayImageSource=steam:1151340
Meta.EndpointURIFormat=
Meta.ConfigManifest=server76config.json
Meta.MetaConfigManifest=
Meta.ConfigRoot=server76.kvp
Meta.MinAMPVersion=2.5.1.8
Meta.SpecificDockerImage=cubecoders/ampbase:debian
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=
Meta.ExtraSetupStepsURI=https://www.c-r-t.tk/~/0mega/Running%20Server76%20on%20Debian/
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=["p7zip","p7zip-full","steamcmd"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=True
Meta.ConfigVersion=7
Meta.ReleaseNotes=v7: all launch fixes baked in. IOREDIR disabled (was breaking .NET apphost launch), gamedir/serverdata passed as absolute paths (Server76's path resolver crashes on relative paths), EULA flag wired to the toggle, DOTNET_ROOT set. Host needs: dotnet-runtime-10.0 (register /etc/dotnet/install_location), p7zip-full, wget. Required game files in gamedata/Data: SeventySix.esm, NW.esm, 'SeventySix - Localization.ba2', Terrain/Appalachia.btd (~2.4 GB total, full BA2 set not needed).
Meta.BreakingReleaseNotes=
Meta.AppConfigId=93b9f631-53e6-42f1-af92-b9c9d3ab02a4
Meta.ImportableExtensions=[]
App.DisplayName=Server76
App.RootDir=./Server76/
App.BaseDirectory=./Server76/bin/
App.SteamWorkshopDownloadLocation=
App.ExecutableWin=
App.ExecutableLinux=bin/Server76.Server
App.WorkingDir=bin
App.LinuxCommandLineArgs=
App.WindowsCommandLineArgs=
App.CommandLineArgs=--headless --no-tui --port {{$ApplicationPort1}} --https-port {{$ApplicationPort2}} --run-as {{RunAs}} --mode {{GameMode}} --gamedir "{{$FullBaseDir}}{{GameDir}}" --serverdata "{{$FullBaseDir}}ServerData" {{AcceptEULA}}
App.UseLinuxIOREDIR=False
App.AppSettings={}
App.EnvironmentVariables={"DOTNET_ROOT":"/usr/share/dotnet"}
App.CommandLineParameterFormat=-{0} {1}
App.CommandLineParameterDelimiter= 
App.ExitMethod=OS_CLOSE
App.ExitTimeout=60
App.ExitString=
App.ExitFile=
App.HasWriteableConsole=False
App.HasReadableConsole=True
App.UDPLogger=False
App.SupportsLiveSettingsChanges=False
App.LiveSettingChangeCommandFormat=
App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=0.0.0.0
App.Ports=@IncludeJson[server76ports.json]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=ApplicationPort1
App.UniversalSleepApplicationUDPPortRef=ApplicationPort1
App.UniversalSleepSteamQueryPortRef=0
App.MaxUsers=24
App.UseRandomAdminPassword=False
App.PersistRandomPassword=False
App.RemoteAdminPassword=
App.AdminMethod=STDIO
App.IgnoreSTDOUTAfterRCON=False
App.AdminLoginTransform=None
App.LoginTransformPrefix=
App.RCONConnectDelaySeconds=5
App.RCONConnectRetrySeconds=5
App.RCONHeartbeatMinutes=0
App.RCONHeartbeatCommand=
App.RCONSelectIPMethod=Default
App.TelnetLoginFormat={0}
App.TelnetNewLineType=Default
App.UpdateSources=@IncludeJSON[server76updates.json]
App.PreStartStages=[]
App.UserActions=[]
App.ForceUpdate=False
App.ForceUpdateReason=
App.Compatibility=None
App.SteamUpdateAnonymousLogin=True
App.SteamForceLoginPrompt=False
App.RapidStartup=False
App.SmartExcludeExemptions=["gamedata/*","ServerData/Database/*","ServerData/Certificates/*","*.esm","*.ba2","Server76Settings.json","Cache/*"]
App.SmartExcludeSupported=True
App.DumpFullChildProcessTree=False
App.MonitorChildProcessName=
App.MonitorDirectChildOnly=False
App.SupportsUniversalSleep=False
App.WakeupMode=Any
App.ApplicationReadyMode=RegexMatch
Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=
